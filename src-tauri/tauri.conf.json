{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nitro Cooler",
  "version": "0.16.3",
  "identifier": "com.nitrocooler.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "powershell -ExecutionPolicy Bypass -File scripts/Run-FrontendDev.ps1",
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File scripts/Run-FrontendBuild.ps1",
    "beforeBundleCommand": "powershell -ExecutionPolicy Bypass -File scripts/Prepare-BundleResources.ps1"
  },
  "app": {
    "windows": [
      {
        "title": "NITRO COOLER",
        "width": 960,
        "height": 560,
        "minWidth": 960,
        "minHeight": 560,
        "maxWidth": 960,
        "maxHeight": 560,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --disable-gpu-compositing"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../aeroforge-service/target/release/aeroforge-service.exe": "aeroforge-service.exe",
      "target/release/aeroforge-hotkey-helper.exe": "aeroforge-hotkey-helper.exe",
      "resources/Install-AeroForgeBundledService.ps1": "Install-AeroForgeBundledService.ps1",
      "../third_party/pawnio/PawnIO_setup.exe": "PawnIO_setup.exe",
      "../third_party/pawnio-modules/IntelMSR.bin": "IntelMSR.bin",
      "target/release/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "minimumWebview2Version": "124.0.2478.67",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "../assets/nitrocooler logo.ico"
    ]
  }
}
